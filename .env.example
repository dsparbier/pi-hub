# pi-hub-agent — copy to .env and fill in. .env is gitignored.
# See docs/AGENT.md §"Deployment" and docs/PLAN-monitoring-consolidation.md §9.

# Two DISTINCT strong random keys (not a fleet placeholder). The console sends one
# of these as X-API-Key from localStorage['fleet.console.keys'] =
#   {"pi-hub-agent":"<read>","pi-hub-agent-admin":"<admin>"}
# read  key: metrics + read-only container view (Plan 1)
# admin key: container control (Plan 2) — the real write boundary for docker.sock
AGENT_READ_KEY=change-me-read
AGENT_ADMIN_KEY=change-me-admin

# gid of the `docker` group on THIS host (Pi and dev box differ):
#   getent group docker | cut -d: -f3
DOCKER_GID=999
